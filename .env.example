# Application Settings
PROJECT_NAME="Peblo TV Mini API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=development-only-change-this-before-any-shared-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peblo_tv_mini

# Optional: Full Database URL (overrides individual credentials above if set)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/peblo_tv_mini

# Local storage (the Docker Compose backend overrides these paths inside its volume)
LOCAL_ARTWORK_STORAGE_DIR=storage/artwork
LOCAL_ARTWORK_URL_PREFIX=/media/artwork
LOCAL_CATALOGUE_STORAGE_DIR=storage/catalogues
SEED_ASSETS_DIR=../assets
